# Vercel → Project → Settings → Environment Variables (all required unless marked optional)
FIREBASE_SERVICE_ACCOUNT=        # paste the whole service-account JSON (Firebase → Project settings → Service accounts → Generate key)
PAYSTACK_SECRET_KEY=sk_live_...  # Paystack → Settings → API keys
NVIDIA_API_KEY=nvapi-...         # optional: AI M-Pesa SMS reading / reminders (the app falls back to built-in parsing without it)
VAPID_PUBLIC_KEY=                # push notifications: run  npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
CRON_SECRET=                     # any long random string; Vercel sends it to the daily reminder job
